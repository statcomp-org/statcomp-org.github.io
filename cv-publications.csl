<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US">
  <info>
    <title>Jun Yan CV</title>
    <id>https://statcomp.org/styles/cv-publications</id>
    <updated>2026-11-14T00:00:00+00:00</updated>
  </info>
  <macro name="authors">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " initialize-with=". " and="text" delimiter=", " delimiter-precedes-last="always"/>
      <substitute>
        <names variable="editor">
          <name name-as-sort-order="all" sort-separator=", " initialize-with=". " and="text" delimiter=", "/>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
      </substitute>
    </names>
  </macro>
  <macro name="container">
    <choose>
      <if type="chapter paper-conference" match="any">
        <group delimiter=", ">
          <group delimiter=" ">
            <text value="In"/>
            <names variable="editor">
              <name initialize-with=". " and="text" delimiter=", "/>
              <label form="short" prefix=" (" suffix=")"/>
            </names>
            <text variable="container-title" font-style="italic"/>
          </group>
          <text variable="volume"/>
          <text variable="page" prefix="pp. "/>
          <text variable="publisher"/>
        </group>
      </if>
      <else>
        <group delimiter=" ">
          <text variable="container-title" font-style="italic"/>
          <group delimiter=": ">
            <group delimiter="">
              <text variable="volume"/>
              <text variable="issue" prefix="(" suffix=")"/>
            </group>
            <text variable="page"/>
          </group>
          <choose><if type="book"><text variable="publisher"/></if></choose>
        </group>
      </else>
    </choose>
  </macro>
  <citation><layout><text macro="authors"/></layout></citation>
  <bibliography>
    <layout suffix=".">
      <group delimiter=". ">
        <group delimiter=": ">
          <group delimiter=" ">
            <text macro="authors"/>
            <date variable="issued" prefix="(" suffix=")"><date-part name="year"/></date>
          </group>
          <choose>
            <if type="book"><text variable="title" font-style="italic"/></if>
            <else><text variable="title"/></else>
          </choose>
        </group>
        <text macro="container"/>
        <text variable="note"/>
      </group>
    </layout>
  </bibliography>
</style>
